{
  "name": "tyulkin",
  "version": "1.0.0",
  "description": "Interactive terminal-style CV of Ivan Tyulkin, frontend developer (React + TypeScript + webpack)",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "webpack-dev-server --open --mode development --hot",
    "typed-styles": "npx typed-scss-modules \"src/**/*.module.scss\" --watch",
    "dev": "concurrently \"npm run start\" \"npm run typed-styles\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prettier": "npx prettier --write .",
    "build": "webpack --mode production"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@eslint-react/eslint-plugin": "^5.24.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^10.0.5",
    "css-loader": "^7.1.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^30.1.2",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "3.9.9",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typed-scss-modules": "^8.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4"
  }
}
